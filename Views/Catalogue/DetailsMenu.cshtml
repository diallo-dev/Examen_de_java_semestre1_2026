@model DetailsViewModel
@{
    ViewData["Title"] = Model.Menu?.Nom;
}

<div class="container my-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Catalogue" class="text-primary-green">Catalogue</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Menu?.Nom</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6 mb-4">
            @if (!string.IsNullOrEmpty(Model.Menu?.UrlImage))
            {
                <div class="position-relative">
                    <img src="@Model.Menu.UrlImage" class="img-fluid rounded-4 shadow-lg border-bottom border-4 border-warning" alt="@Model.Menu.Nom" style="width: 100%; height: 500px; object-fit: cover;">
                    <div class="position-absolute top-0 start-0 m-3">
                        <span class="badge bg-accent text-dark fs-6 shadow">MENU COMPLET</span>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-light-green text-secondary-green d-flex align-items-center justify-content-center rounded-4 shadow" style="height: 500px;">
                    <i class="fas fa-utensils fa-10x"></i>
                </div>
            }
        </div>

        <div class="col-md-6">
            <div class="ps-md-4">
                <h1 class="display-5 fw-bold text-primary-green mb-2">@Model.Menu?.Nom</h1>
                <p class="lead text-muted mb-4">@Model.Menu?.Description</p>

                <div class="card border-0 bg-light rounded-4 mb-4 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold text-primary-green mb-3">
                            <i class="fas fa-box-open me-2 text-accent-gold"></i> Dans votre menu :
                        </h5>
                        <div class="list-group list-group-flush bg-transparent">
                            @if (Model.Menu?.Burger != null)
                            {
                                <div class="list-group-item bg-transparent border-0 px-0 d-flex align-items-center">
                                    <div class="bg-white rounded-circle p-2 shadow-sm me-3">
                                        <i class="fas fa-burger text-success"></i>
                                    </div>
                                    <div>
                                        <span class="d-block fw-bold">@Model.Menu.Burger.Nom</span>
                                        <small class="text-muted">Burger signature</small>
                                    </div>
                                </div>
                            }
                            @if (Model.Menu?.Complements != null && Model.Menu.Complements.Any())
                            {
                                foreach (var complement in Model.Menu.Complements)
                                {
                                    <div class="list-group-item bg-transparent border-0 px-0 d-flex align-items-center">
                                        <div class="bg-white rounded-circle p-2 shadow-sm me-3">
                                            <i class="fas fa-plus text-accent-gold"></i>
                                        </div>
                                        <span class="fw-bold">@complement.Nom</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <div class="price-badge mb-4">
                    @Model.Menu?.PrixTotal <span class="fs-5">FCFA</span>
                </div>

                <form method="post" action="/Commande/AjouterMenu">
                    <input type="hidden" name="id" value="@Model.Menu?.Id" />

                    <div class="row g-3 align-items-end mb-4">
                        <div class="col-4">
                            <label class="form-label fw-bold text-muted small">QUANTITÉ</label>
                            <input type="number" name="quantite" class="form-control form-control-lg border-2 rounded-3" value="1" min="1" max="10">
                        </div>
                        <div class="col-8">
                            <button type="submit" class="btn btn-primary btn-lg w-100 py-3 shadow-sm">
                                <i class="fas fa-cart-plus me-2"></i> AJOUTER LE MENU
                            </button>
                        </div>
                    </div>
                </form>

                <a href="/Catalogue" class="btn btn-outline-secondary w-100 border-2">
                    <i class="fas fa-chevron-left me-2"></i> Retour au catalogue
                </a>
            </div>
        </div>
    </div>
</div>