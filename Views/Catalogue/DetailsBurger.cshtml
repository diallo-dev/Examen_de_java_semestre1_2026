@model DetailsViewModel
@{
    ViewData["Title"] = Model.Burger?.Nom;
}

<div class="container my-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Catalogue" class="text-primary-green">Catalogue</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Burger?.Nom</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6 mb-4">
            @if (!string.IsNullOrEmpty(Model.Burger?.UrlImage))
            {
                <img src="@Model.Burger.UrlImage" class="img-fluid rounded-4 shadow-lg border-bottom border-4 border-warning" alt="@Model.Burger.Nom" style="width: 100%; height: 450px; object-fit: cover;">
            }
            else
            {
                <div class="bg-light-green text-secondary-green d-flex align-items-center justify-content-center rounded-4 shadow" style="height: 450px;">
                    <i class="fas fa-burger fa-10x"></i>
                </div>
            }
        </div>

        <div class="col-md-6">
            <div class="ps-md-4">
                <h1 class="display-5 fw-bold text-primary-green">@Model.Burger?.Nom</h1>
                <p class="lead text-muted mb-4">@Model.Burger?.Description</p>
                
                <div class="price-badge mb-4">
                    @Model.Burger?.Prix <span class="fs-5">FCFA</span>
                </div>

                <div class="card bg-light border-0 rounded-4 p-4 mb-4">
                    <form method="post" action="/Commande/AjouterBurger">
                        <input type="hidden" name="id" value="@Model.Burger?.Id" />

                        <div class="mb-4">
                            <label class="form-label fw-bold text-primary-green"><i class="fas fa-list-ol"></i> Quantité</label>
                            <div class="input-group" style="max-width: 150px;">
                                <input type="number" name="quantite" class="form-control form-control-lg border-2" value="1" min="1" max="10">
                            </div>
                        </div>

                        @if (Model.ComplementsDisponibles.Any())
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold text-primary-green">
                                    <i class="fas fa-plus-circle"></i> Personnalisez votre plaisir (Compléments)
                                </label>
                                <div class="bg-white rounded-3 p-3 shadow-sm">
                                    @foreach (var complement in Model.ComplementsDisponibles)
                                    {
                                        <div class="form-check mb-2 p-2 rounded-2 panier-item">
                                            <input class="form-check-input ms-0 me-2" type="checkbox" name="complementIds" value="@complement.Id" id="comp_@complement.Id">
                                            <label class="form-check-label d-flex justify-content-between align-items-center w-100" for="comp_@complement.Id">
                                                <span>@complement.Nom</span>
                                                <span class="badge bg-light text-dark-text border">+@complement.Prix FCFA</span>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm py-3 mb-2">
                            <i class="fas fa-cart-plus me-2"></i> AJOUTER AU PANIER
                        </button>
                    </form>

                    <a href="/Catalogue" class="btn btn-outline-secondary w-100 border-2 mt-2">
                        <i class="fas fa-chevron-left me-2"></i> Retour au catalogue
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>