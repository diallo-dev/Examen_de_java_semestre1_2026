@model DetailsViewModel
@{
    ViewData["Title"] = Model.Burger?.Nom;
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Burger?.UrlImage))
            {
                <img src="@Model.Burger.UrlImage" class="img-fluid rounded shadow" alt="@Model.Burger.Nom">
            }
            else
            {
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                    <i class="fas fa-burger fa-10x"></i>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h1 class="display-4">@Model.Burger?.Nom</h1>
            <p class="lead text-muted">@Model.Burger?.Description</p>
            <h2 class="text-danger">@Model.Burger?.Prix FCFA</h2>

            <form method="post" action="/Commande/AjouterBurger">
                <input type="hidden" name="id" value="@Model.Burger?.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Quantité</label>
                    <input type="number" name="quantite" class="form-control" value="1" min="1" max="10">
                </div>

                @if (Model.ComplementsDisponibles.Any())
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">Compléments (optionnel)</label>
                        @foreach (var complement in Model.ComplementsDisponibles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="complementIds" value="@complement.Id" id="comp_@complement.Id">
                                <label class="form-check-label" for="comp_@complement.Id">
                                    @complement.Nom (+@complement.Prix FCFA)
                                </label>
                            </div>
                        }
                    </div>
                }

                <button type="submit" class="btn btn-danger btn-lg w-100">
                    <i class="fas fa-shopping-cart"></i> Ajouter au panier
                </button>
            </form>

            <a href="/Catalogue" class="btn btn-outline-secondary mt-3 w-100">
                <i class="fas fa-arrow-left"></i> Retour au catalogue
            </a>
        </div>
    </div>
</div>
