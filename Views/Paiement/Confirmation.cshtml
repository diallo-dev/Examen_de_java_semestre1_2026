@model Commande
@{
    ViewData["Title"] = "Confirmation";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body text-center py-5">
                    <div class="text-success mb-4">
                        <i class="fas fa-check-circle fa-5x"></i>
                    </div>
                    <h1 class="text-success mb-3">Paiement réussi !</h1>
                    <p class="lead">Votre commande a été validée et payée avec succès.</p>

                    <div class="alert alert-info mt-4">
                        <h4>Commande N° @Model.Id</h4>
                        <p><strong>Montant payé :</strong> @Model.MontantTotal FCFA</p>
                        <p><strong>Mode de consommation :</strong> @Model.LieuConsommation</p>
                        <p><strong>Date :</strong> @Model.Date.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>

                    <div class="mt-4">
                        <a href="/Commande/MesCommandes" class="btn btn-primary btn-lg me-2">
                            <i class="fas fa-list"></i> Voir mes commandes
                        </a>
                        <a href="/Catalogue" class="btn btn-outline-danger btn-lg">
                            <i class="fas fa-home"></i> Retour à l'accueil
                        </a>
                    </div>

                    <div class="mt-5">
                        <p class="text-muted">
                            <i class="fas fa-info-circle"></i> 
                            Un email de confirmation vous a été envoyé.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
