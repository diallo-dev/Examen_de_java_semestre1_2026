<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasil Burger</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary-green shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold animate__animated animate__fadeInLeft" href="/">
                    <i class="fas fa-burger text-accent-yellow"></i> BRASIL <span class="text-accent-yellow">BURGER</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link px-3" href="/Catalogue">Carte</a>
                        </li>
                        
                        @if (Context.Session.GetInt32("ClientId").HasValue)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" href="/Commande/MesCommandes">Suivi Commandes</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <div class="nav-link bg-dark-charcoal rounded-pill px-3 py-1 text-accent-yellow small">
                                    <i class="fas fa-user-circle"></i> @Context.Session.GetString("ClientNom")
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-muted small px-3" href="/Auth/Deconnexion">Déconnexion</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" href="/Auth/Connexion">Connexion</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-primary rounded-pill btn-sm px-4" href="/Auth/Inscription">S'inscrire</a>
                            </li>
                        }
                        
                        <li class="nav-item ms-lg-3">
                            <a class="nav-link position-relative panier-icon p-2" href="/Commande/Panier">
                                <i class="fas fa-shopping-basket fa-lg"></i>
                                <span class="badge rounded-pill bg-accent text-dark position-absolute top-0 start-100 translate-middle shadow-sm" id="panier-count">
                                    0
                                </span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <div class="container mt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show animate__animated animate__fadeInDown" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-warning border-0 shadow-sm alert-dismissible fade show animate__animated animate__fadeInDown" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <footer class="footer-custom">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                    <h5 class="fw-bold text-accent-yellow mb-0">BRASIL BURGER</h5>
                    <p class="small text-muted mb-0">La qualité gourmet à votre porte.</p>
                </div>
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <p class="mb-0">
                        <i class="fas fa-phone text-accent-yellow"></i> +221 77 123 45 67
                    </p>
                    <p class="small text-muted">Dakar, Sénégal</p>
                </div>
                <div class="col-md-4 text-center text-md-end">
                    <div class="social-links">
                        <a href="#" class="text-white mx-2"><i class="fab fa-instagram fa-lg"></i></a>
                        <a href="#" class="text-white mx-2"><i class="fab fa-facebook fa-lg"></i></a>
                        <a href="#" class="text-white mx-2"><i class="fab fa-whatsapp fa-lg"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4" style="opacity: 0.1;">
            <div class="text-center small text-muted">
                &copy; @DateTime.Now.Year Brasil Burger - Tous droits réservés
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>