@model PanierViewModel
@{
    ViewData["Title"] = "Mon Panier";
}

<div class="container my-5">
    <h1 class="text-center mb-4">
        <i class="fas fa-shopping-cart"></i> Mon Panier
    </h1>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info text-center">
            <h4>Votre panier est vide</h4>
            <p>Ajoutez des produits depuis notre carte</p>
            <a href="/Catalogue" class="btn btn-danger">
                <i class="fas fa-utensils"></i> Voir la carte
            </a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                @foreach (var item in Model.Items)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    @if (!string.IsNullOrEmpty(item.UrlImage))
                                    {
                                        <img src="@item.UrlImage" class="img-fluid rounded" alt="@item.Nom">
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 80px;">
                                            <i class="fas fa-burger fa-2x"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <h5>@item.Nom</h5>
                                    @if (item.Type == "menu")
                                    {
                                        <span class="badge bg-warning text-dark">MENU</span>
                                    }
                                    @if (item.Complements.Any())
                                    {
                                        <small class="text-muted d-block">
                                            + @string.Join(", ", item.Complements.Select(c => c.Nom))
                                        </small>
                                    }
                                </div>
                                <div class="col-md-2">
                                    <strong>@item.Prix FCFA</strong>
                                </div>
                                <div class="col-md-2">
                                    <strong>x @item.Quantite</strong>
                                </div>
                                <div class="col-md-2">
                                    <form method="post" action="/Commande/RetirerItem">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="type" value="@item.Type" />
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">Résumé</h5>
                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Nombre d'articles :</span>
                            <strong>@Model.NombreItems</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Total :</span>
                            <h4 class="text-danger">@Model.Total FCFA</h4>
                        </div>
                        <a href="/Commande/Valider" class="btn btn-danger btn-lg w-100">
                            <i class="fas fa-check"></i> Valider la commande
                        </a>
                        <a href="/Catalogue" class="btn btn-outline-secondary mt-2 w-100">
                            Continuer mes achats
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
