@using BrasilBurger.Web.ViewModels
@model PanierViewModel
@{
    ViewData["Title"] = "Mon Panier";
}

<div class="container my-5">
    <h2 class="mb-4"><i class="fas fa-shopping-basket"></i> Votre Panier</h2>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="alert alert-warning text-center">
            <h4>Votre panier est vide.</h4>
            <a href="/" class="btn btn-primary mt-3">Retourner au catalogue</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                @foreach (var item in Model.Items)
                {
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-2">
                                    <img src="@(string.IsNullOrEmpty(item.UrlImage) ? "/img/default.jpg" : item.UrlImage)" class="img-fluid rounded" alt="@item.Nom">
                                </div>
                                <div class="col-4">
                                    <h5 class="mb-0">@item.Nom</h5>
                                    <small class="text-muted">Type: @item.Type</small>
                                    @if(item.Complements.Any()){
                                        <div class="small text-success">+ @string.Join(", ", item.Complements.Select(c => c.Nom))</div>
                                    }
                                </div>
                                <div class="col-3 text-center">
                                    <span>@item.Quantite x @item.Prix FCFA</span>
                                </div>
                                <div class="col-3 text-end">
                                    <form asp-action="RetirerItem" method="post">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="type" value="@item.Type" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-trash"></i> Retirer
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-primary">
                    <div class="card-header bg-primary text-white">Résumé de la commande</div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Articles :</span>
                            <strong>@Model.NombreItems</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="h5">Total :</span>
                            <strong class="h5 text-danger">@Model.Total FCFA</strong>
                        </div>
                        <a asp-action="Valider" class="btn btn-success btn-lg w-100">
                            Commander <i class="fas fa-chevron-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>