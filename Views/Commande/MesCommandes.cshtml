@model MesCommandesViewModel
@{
    ViewData["Title"] = "Mes Commandes";
}

<div class="container my-5">
    <div class="d-flex align-items-center justify-content-center mb-5">
        <div class="flex-grow-1" style="height: 2px; background: var(--border-color);"></div>
        <h1 class="px-4 text-primary-green fw-bold text-uppercase">
            <i class="fas fa-history"></i> Historique de mes commandes
        </h1>
        <div class="flex-grow-1" style="height: 2px; background: var(--border-color);"></div>
    </div>

    @if (!Model.Commandes.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <div class="card-body">
                <i class="fas fa-receipt fa-5x text-light-green mb-4"></i>
                <h4 class="text-muted">Vous n'avez pas encore passé de commande.</h4>
                <p>Découvrez notre carte et faites-vous plaisir !</p>
                <a href="/Catalogue" class="btn btn-primary btn-lg px-5 mt-3">
                    <i class="fas fa-utensils"></i> Voir le menu
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var commande in Model.Commandes)
            {
                <div class="col-md-12 mb-4">
                    <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 15px;">
                        <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-uppercase small fw-bold text-muted">Référence</span>
                                <h5 class="mb-0 text-primary-green fw-bold">#CMD-@commande.Id.ToString().PadLeft(5, '0')</h5>
                            </div>
                            <div class="text-center">
                                @{
                                    var etatClass = commande.EtatCmd switch
                                    {
                                        "NonTraiter" => "bg-light text-dark",
                                        "Encours_Preparation" => "bg-warning text-dark",
                                        "Terminer" => "bg-secondary-green text-white",
                                        "EnCours_Livraison" => "bg-info text-white",
                                        "Livrer" => "bg-primary-green text-white",
                                        _ => "bg-light"
                                    };

                                    var etatTexte = commande.EtatCmd switch
                                    {
                                        "NonTraiter" => "Attente validation",
                                        "Encours_Preparation" => "En cuisine 🍳",
                                        "Terminer" => "Prête ! 🍔",
                                        "EnCours_Livraison" => "En chemin 🛵",
                                        "Livrer" => "Livrée ✅",
                                        _ => commande.EtatCmd
                                    };
                                }
                                <span class="badge @etatClass px-3 py-2 rounded-pill shadow-sm">
                                    @etatTexte
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                <div class="col-md-7">
                                    <div class="d-flex mb-3">
                                        <div class="me-4">
                                            <p class="text-muted small mb-1">Date</p>
                                            <p class="fw-bold mb-0">@commande.Date.ToString("dd MMM yyyy HH:mm")</p>
                                        </div>
                                        <div>
                                            <p class="text-muted small mb-1">Service</p>
                                            <p class="fw-bold mb-0">
                                                <i class="fas fa-concierge-bell text-accent-gold"></i>
                                                @(commande.LieuConsommation == "SurPlace" ? "Sur place" : 
                                                  commande.LieuConsommation == "Emporter" ? "À emporter" : "Livraison")
                                            </p>
                                        </div>
                                    </div>

                                    @if (commande.Items != null && commande.Items.Any())
                                    {
                                        <div class="bg-light-green p-3 rounded-3">
                                            <p class="small fw-bold text-primary-green mb-2 text-uppercase">Détails du panier</p>
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var item in commande.Items)
                                                {
                                                    <li class="d-flex justify-content-between mb-1">
                                                        <span><i class="fas fa-check-circle text-secondary-green me-2"></i> @item.Nom</span>
                                                        <span class="fw-bold text-muted">x @item.Quantite</span>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-5 text-end mt-3 mt-md-0 border-start-md ps-md-4">
                                    <p class="text-muted small mb-0 text-uppercase">Total de la commande</p>
                                    <div class="price-tag fs-3 my-2 shadow-none border-0">
                                        @commande.MontantTotal <small class="fs-6">FCFA</small>
                                    </div>
                                    
                                    <div class="mt-2">
                                        @if (commande.EstPayee)
                                        {
                                            <span class="text-success fw-bold p-2">
                                                <i class="fas fa-check-double"></i> Paiement validé
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-warning fw-bold p-2 border border-warning rounded-pill px-3">
                                                <i class="fas fa-clock"></i> Règlement en attente
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-light border-0 text-center py-2">
                            <small class="text-muted">Merci de votre confiance chez Brasil Burger !</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>