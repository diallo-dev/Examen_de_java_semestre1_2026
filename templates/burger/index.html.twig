{% extends 'base.html.twig' %}
{% block title %}Gestion Burgers{% endblock %}
{% block body %}
<h1 class="mb-4"><i class="fas fa-hamburger"></i> Gestion des Burgers</h1>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-danger">
            <tr>
                <th>Image</th>
                <th>Nom</th>
                <th>Prix</th>
                <th>État</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for burger in burgers %}
                <tr>
                    <td>
                        {% if burger.urlImage %}
                            <img src="{{ burger.urlImage }}" style="width:50px;height:50px;object-fit:cover;" class="rounded">
                        {% else %}
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="width:50px;height:50px;">
                                <i class="fas fa-hamburger"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td>{{ burger.nom }}</td>
                    <td>{{ burger.prix|number_format(0, ',', ' ') }} FCFA</td>
                    <td>
                        <span class="badge bg-{{ burger.etatstock == 'disponible' ? 'success' : (burger.etatstock == 'archiver' ? 'secondary' : 'warning') }}">
                            {{ burger.etatstock }}
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('burger_edit', {id: burger.id}) }}" class="btn btn-sm btn-primary">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        {% if not burger.isArchive %}
                            <form method="post" action="{{ path('burger_archive', {id: burger.id}) }}" style="display:inline;" 
                                  onsubmit="return confirm('Archiver ce burger ?');">
                                <button type="submit" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-archive"></i> Archiver
                                </button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted">Aucun burger</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
