{% extends 'base.html.twig' %}
{% block title %}Commandes Zone {{ zoneId }}{% endblock %}
{% block body %}
<h1 class="mb-4"><i class="fas fa-map-marker-alt"></i> Commandes Zone {{ zoneId }}</h1>

<div class="alert alert-info">
    <strong>{{ commandes|length }}</strong> commande(s) en livraison pour cette zone sans livreur affecté
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-danger">
            <tr>
                <th>#</th>
                <th>Date</th>
                <th>Client</th>
                <th>Adresse</th>
                <th>Montant</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for commande in commandes %}
                <tr>
                    <td>{{ commande.id }}</td>
                    <td>{{ commande.date|date('d/m/Y H:i') }}</td>
                    <td>{{ commande.client ? commande.client.nomComplet : 'N/A' }}</td>
                    <td>{{ commande.client ? commande.client.adresse : 'N/A' }}</td>
                    <td>{{ commande.montantTotal|number_format(0, ',', ' ') }} F</td>
                    <td>
                        <a href="{{ path('commande_show', {id: commande.id}) }}" class="btn btn-sm btn-info">
                            <i class="fas fa-eye"></i> Voir
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-center text-muted">Aucune commande</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<a href="{{ path('commande_index') }}" class="btn btn-secondary">
    <i class="fas fa-arrow-left"></i> Retour
</a>
{% endblock %}
