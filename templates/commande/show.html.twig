{% extends 'base.html.twig' %}
{% block title %}Détails Commande #{{ commande.id }}{% endblock %}
{% block body %}
<h1 class="mb-4"><i class="fas fa-receipt"></i> Détails Commande #{{ commande.id }}</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-danger text-white">
                <h5><i class="fas fa-info-circle"></i> Informations</h5>
            </div>
            <div class="card-body">
                <p><strong>Date:</strong> {{ commande.date|date('d/m/Y à H:i') }}</p>
                <p><strong>Client:</strong> {{ commande.client ? commande.client.nomComplet : 'N/A' }}</p>
                <p><strong>Email:</strong> {{ commande.client ? commande.client.email : 'N/A' }}</p>
                <p><strong>Téléphone:</strong> {{ commande.client ? commande.client.telephone : 'N/A' }}</p>
                <p><strong>Lieu:</strong> 
                    <span class="badge bg-{{ commande.lieuConsommation == 'Livraison' ? 'info' : 'secondary' }}">
                        {{ commande.lieuConsommation }}
                    </span>
                </p>
                {% if commande.lieuConsommation == 'Livraison' %}
                    <p><strong>Adresse:</strong> {{ commande.client.adresse ?? 'N/A' }}</p>
                    <p><strong>Zone:</strong> Zone {{ commande.idZone }}</p>
                    <p><strong>Frais livraison:</strong> {{ commande.fraisLivraison|number_format(0, ',', ' ') }} FCFA</p>
                {% endif %}
                <p><strong>État:</strong> 
                    <span class="badge bg-{{ commande.etatCmd == 'Terminer' ? 'success' : (commande.etatCmd == 'Annuler' ? 'danger' : 'warning') }}">
                        {{ commande.etatCmd }}
                    </span>
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-danger text-white">
                <h5><i class="fas fa-shopping-bag"></i> Articles</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Article</th>
                            <th>Qté</th>
                            <th>Prix U.</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            <tr>
                                <td>{{ item.nom }}</td>
                                <td>{{ item.quantite }}</td>
                                <td>{{ item.prix_unitaire|number_format(0, ',', ' ') }}</td>
                                <td>{{ item.total|number_format(0, ',', ' ') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="table-active">
                            <th colspan="3">TOTAL</th>
                            <th>{{ commande.montantTotal|number_format(0, ',', ' ') }} FCFA</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="{{ path('commande_index') }}" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Retour
    </a>
    {% if commande.etatCmd == 'NonTraiter' %}
        <form method="post" action="{{ path('commande_terminer', {id: commande.id}) }}" style="display:inline;">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-check"></i> Marquer comme Terminé
            </button>
        </form>
        <form method="post" action="{{ path('commande_annuler', {id: commande.id}) }}" style="display:inline;" 
              onsubmit="return confirm('Annuler cette commande ?');">
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-times"></i> Annuler la Commande
            </button>
        </form>
    {% endif %}
</div>
{% endblock %}
