{% extends 'base.html.twig' %}

{% block title %}Dashboard | Brasil Burger{% endblock %}

{% block body %}
<style>
    :root {
        --bb-primary: #d63031; /* Rouge profond */
        --bb-dark: #2d3436;
        --bb-light: #f9f9f9;
        --bb-shadow: 0 10px 20px rgba(0,0,0,0.08);
    }

    body { background-color: #f4f7f6; }

    .page-title {
        font-weight: 800;
        color: var(--bb-dark);
        letter-spacing: -1px;
        margin-bottom: 1.5rem;
    }

    /* Style des Cartes de Stats */
    .stat-card {
        border: none;
        border-radius: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
        position: relative;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.12);
    }

    .stat-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 3rem;
        opacity: 0.2;
    }

    .stat-value {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 0;
    }

    .stat-label {
        font-size: 0.9rem;
        text-transform: uppercase;
        font-weight: 600;
        opacity: 0.9;
    }

    /* Listes de Classement */
    .ranking-card {
        border: none;
        border-radius: 15px;
        box-shadow: var(--bb-shadow);
    }

    .ranking-header {
        border-radius: 15px 15px 0 0 !important;
        padding: 1.2rem;
        background: linear-gradient(45deg, #d63031, #e17055);
    }

    .list-group-item {
        border: none;
        border-bottom: 1px solid #eee;
        padding: 1rem 1.25rem;
        transition: background 0.2s;
    }

    .list-group-item:last-child { border-bottom: none; }
    .list-group-item:hover { background-color: #fff9f9; }

    .rank-number {
        width: 25px;
        height: 25px;
        background: #eee;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        margin-right: 10px;
        color: #777;
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="page-title">
            <i class="fas fa-chart-pie text-danger me-2"></i>Dashboard <small class="text-muted fs-5 fw-light">Statistiques du jour</small>
        </h1>
        <span class="badge bg-white text-dark shadow-sm p-2 border">
            <i class="far fa-calendar-alt me-1 text-danger"></i> {{ "now"|date("d F Y") }}
        </span>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card stat-card bg-warning text-dark shadow-sm">
                <div class="card-body p-4">
                    <div class="stat-label">En Cours</div>
                    <p class="stat-value">{{ stats.commandesEnCours }}</p>
                    <i class="fas fa-clock stat-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card bg-success text-white shadow-sm">
                <div class="card-body p-4">
                    <div class="stat-label">Livrées</div>
                    <p class="stat-value">{{ stats.commandesValidees }}</p>
                    <i class="fas fa-check-circle stat-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card bg-danger text-white shadow-sm">
                <div class="card-body p-4">
                    <div class="stat-label">Annulées</div>
                    <p class="stat-value">{{ stats.commandesAnnulees }}</p>
                    <i class="fas fa-times-circle stat-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card bg-dark text-white shadow-sm">
                <div class="card-body p-4">
                    <div class="stat-label text-info">Chiffre d'Affaire</div>
                    <p class="stat-value">{{ stats.recettes|number_format(0, ',', ' ') }} <small style="font-size: 1rem">F</small></p>
                    <i class="fas fa-wallet stat-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card ranking-card h-100">
                <div class="card-header ranking-header text-white border-0">
                    <h5 class="mb-0"><i class="fas fa-fire me-2"></i>Burgers les Plus Vendus</h5>
                </div>
                <div class="card-body p-0">
                    {% if stats.burgersPlusVendus is empty %}
                        <div class="p-5 text-center">
                            <i class="fas fa-hamburger fa-3x text-light mb-3"></i>
                            <p class="text-muted">Aucune vente enregistrée aujourd'hui</p>
                        </div>
                    {% else %}
                        <div class="list-group list-group-flush">
                            {% for burger in stats.burgersPlusVendus %}
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="rank-number">{{ loop.index }}</span>
                                        <span class="fw-bold text-dark">{{ burger.nom }}</span>
                                    </div>
                                    <span class="badge bg-danger rounded-pill">{{ burger.total_vendu }} ventes</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card ranking-card h-100">
                <div class="card-header ranking-header text-white border-0" style="background: linear-gradient(45deg, #2d3436, #636e72);">
                    <h5 class="mb-0"><i class="fas fa-star me-2"></i>Menus Favoris</h5>
                </div>
                <div class="card-body p-0">
                    {% if stats.menusPlusVendus is empty %}
                        <div class="p-5 text-center">
                            <i class="fas fa-utensils fa-3x text-light mb-3"></i>
                            <p class="text-muted">Aucune vente enregistrée aujourd'hui</p>
                        </div>
                    {% else %}
                        <div class="list-group list-group-flush">
                            {% for menu in stats.menusPlusVendus %}
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="rank-number text-white bg-dark">{{ loop.index }}</span>
                                        <span class="fw-bold text-dark">{{ menu.nom }}</span>
                                    </div>
                                    <span class="badge bg-info text-dark rounded-pill">{{ menu.total_vendu }} ventes</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}