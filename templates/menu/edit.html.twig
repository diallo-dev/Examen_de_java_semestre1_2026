{% extends 'base.html.twig' %}
{% block title %}Modifier Menu{% endblock %}
{% block body %}
<h1 class="mb-4"><i class="fas fa-edit"></i> Modifier le Menu</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                {{ form_start(form) }}
                    {{ form_row(form.nom) }}
                    {{ form_row(form.prixTotal) }}
                    {{ form_row(form.urlImage) }}
                    {{ form_row(form.description) }}
                    {{ form_row(form.etatstock) }}
                    <div class="mt-3">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Enregistrer
                        </button>
                        <a href="{{ path('menu_index') }}" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Annuler
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
