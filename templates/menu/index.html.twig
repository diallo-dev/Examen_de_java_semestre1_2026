{% extends 'base.html.twig' %}
{% block title %}Gestion Menus{% endblock %}
{% block body %}
<h1 class="mb-4"><i class="fas fa-utensils"></i> Gestion des Menus</h1>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-danger">
            <tr>
                <th>Image</th>
                <th>Nom</th>
                <th>Prix</th>
                <th>État</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for menu in menus %}
                <tr>
                    <td>
                        {% if menu.urlImage %}
                            <img src="{{ menu.urlImage }}" style="width:50px;height:50px;object-fit:cover;" class="rounded">
                        {% else %}
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="width:50px;height:50px;">
                                <i class="fas fa-utensils"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td>{{ menu.nom }}</td>
                    <td>{{ menu.prixTotal|number_format(0, ',', ' ') }} FCFA</td>
                    <td>
                        <span class="badge bg-{{ menu.etatstock == 'disponible' ? 'success' : (menu.etatstock == 'archiver' ? 'secondary' : 'warning') }}">
                            {{ menu.etatstock }}
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('menu_edit', {id: menu.id}) }}" class="btn btn-sm btn-primary">
                            <i class="fas fa-edit"></i> Modifier
                        </a>
                        {% if not menu.isArchive %}
                            <form method="post" action="{{ path('menu_archive', {id: menu.id}) }}" style="display:inline;" 
                                  onsubmit="return confirm('Archiver ce menu ?');">
                                <button type="submit" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-archive"></i> Archiver
                                </button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center text-muted">Aucun menu</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
